# Generated at image build time from grub.cfg.in
set default=0
set timeout=3

insmod part_gpt
insmod fat
insmod ext2
insmod gzio
insmod search_label

menuentry "Novolis OS" {
  search --no-floppy --set=root --label novolisos
  linux /boot/@@KERNEL@@ root=LABEL=novolisos rw rootfstype=ext4 console=tty0
  initrd /boot/@@INITRD@@
}
